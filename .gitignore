__pycache__/
*.pyc
*.pyo
*.pyd

# Keep the folder in the repo, ignore everything in it: a fresh clone gets the
# paths the launch + polysetup flows expect, without the machine-local contents.
# `dir/*` and not `dir/` on purpose — a trailing-slash directory ignore stops git
# descending at all, so the negation below would never be reached.
environment_configs/*
!environment_configs/.gitkeep
lidar_drivers/*
!lidar_drivers/.gitkeep

# Same idea one level deeper: keep results_locations/ and its two output folders,
# ignore all run output inside them. Each nested level needs its own re-include of
# the *directory* (`!dir/`) before its contents can be ignored — otherwise git stops
# descending at the parent and never sees the deeper rules.
results_locations/*
!results_locations/metrics_results/
!results_locations/rosbags/
results_locations/metrics_results/*
!results_locations/metrics_results/.gitkeep
results_locations/rosbags/*
!results_locations/rosbags/.gitkeep

build/
log/
install/

# Local Claude Code settings
.claude/settings.local.json

# Lidar eval backends
lidar_eval_backends/auth.env
lidar_eval_backends/lidar_eval_backends.egg-info

# Local toggles written by polysetup-bag-recording (BAG_RECORDING)
.env