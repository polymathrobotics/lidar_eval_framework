<?xml version="1.0" ?>
<robot name="lidar_bench" version="1.0">
  <link name="map"/>
  <link name="motor_axis"/>
  <link name="white_wall">
    <visual>
      <geometry>
        <box size="0.0 1.2446 1.3716"/>
      </geometry>
      <material name="white_wall_material">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="map_to_white_wall" type="fixed">
    <origin xyz="4.064 0.0 0.93218" rpy="0.0 0.0 0.0"/>
    <parent link="map"/>
    <child link="white_wall"/>
  </joint>
  <joint name="map_to_motor" type="continuous">
    <origin xyz="0.0 0.0 0.9406" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <parent link="map"/>
    <child link="motor_axis"/>
  </joint>
  <link name="hesai_lidar"/>
  <joint name="hesai_lidar_joint" type="fixed">
    <origin xyz="0.0 0.0 0.09" rpy="0.0 0.0 -1.5708"/>
    <parent link="motor_axis"/>
    <child link="hesai_lidar"/>
  </joint>
</robot>