<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_automation_manager</name>
  <version>0.0.0</version>
  <description>Automates lidar test-bench runs: drives drivers, angles, parameter sweeps and bag recording.</description>
  <maintainer email="engineering@polymathrobotics.com">Engineering</maintainer>
  <license>Apache 2.0</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>ros2bag</depend>
  <depend>rosbag2_storage_mcap</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
